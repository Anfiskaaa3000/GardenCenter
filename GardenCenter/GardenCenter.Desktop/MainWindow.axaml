<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GardenCenter.MainWindow"
        Title="Садовый центр - Каталог" Width="900" Height="700">

    <DockPanel>
        <!-- Шапка приложения -->
        <Border DockPanel.Dock="Top" Background="#E8F5E9" Padding="15">
            <TextBlock Text="🌿 Каталог садового центра" FontSize="22" FontWeight="Bold" Foreground="#2E7D32" />
        </Border>
                <!-- Панель с выбором пользователя и поиском -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="15,10,15,10">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
            <ComboBox x:Name="UserBox" MinWidth="200" PlaceholderText="Кто вы?"/>
            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,5,0"/>
            <TextBox x:Name="SearchBox" MinWidth="250" Watermark="Название товара..." TextChanged="SearchChanged"/>
        </StackPanel>
        <!-- Список карточек -->
        <ListBox x:Name="ProductsList" Margin="15" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10" Background="White">
                        <Grid ColumnDefinitions="120, *">
                            <!-- Картинка товара -->
                            <Border Width="100" Height="100" CornerRadius="5" ClipToBounds="True" Background="#F5F5F5">
                                <Image Source="{Binding FullImagePath}" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BasePrice, StringFormat='Цена: {0} руб.'}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="0,10,0,0"/>
                                <Button Content="Купить" Click="BuyClick" CommandParameter="{Binding ProductId}" 
        HorizontalAlignment="Left" Margin="0,10,0,0" Background="#2E7D32" Foreground="White" Padding="15,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>