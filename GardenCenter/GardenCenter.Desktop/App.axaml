<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GardenCenter.App"
             RequestedThemeVariant="Light">
    
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Светло-зеленый фон шапки (тематика садового центра) -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#E8F5E9" />
        <!-- Темно-зеленый для кнопок и акцентов -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2E7D32" />
    </Application.Resources>
    
</Application>